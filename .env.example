# Copie este arquivo para ".env" e ajuste os valores.
PORT=3000

# Banco MySQL (o mesmo que você criou no DBeaver)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=luana_salgadinhos

# Fuso horário do estabelecimento (usado nas datas do banco)
APP_TIMEZONE=America/Cuiaba

# Quem pode chamar a API pelo navegador. "*" libera todos (ok para desenvolvimento).
CORS_ORIGIN=*

# Pasta com o front (painel.html, estoque.html, produto.html). Opcional.
FRONTEND_DIR=public
